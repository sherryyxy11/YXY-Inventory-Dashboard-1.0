# --- Shopify store ---
SHOPIFY_SHOP=yxy-zugo.myshopify.com
SHOPIFY_API_VERSION=2026-10

# Option A (recommended): a Dev Dashboard app installed on the store.
# The server exchanges these for an access token and refreshes it every 24h.
# The client secret is also used to verify incoming webhooks.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Option B: an existing admin-created custom app's Admin API access token (shpat_...).
# If you use this, also set SHOPIFY_WEBHOOK_SECRET to that app's API secret key to enable webhooks.
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_WEBHOOK_SECRET=

# Optional: which location's stock to manage (defaults to the first active location).
SHOPIFY_LOCATION_ID=

# --- Dashboard ---
PORT=3000
# Required in production: everyone opening the dashboard must enter this password.
DASHBOARD_PASSWORD=
# Variants at or below this quantity are flagged "Low".
LOW_STOCK_THRESHOLD=10

# Public https URL of this server (e.g. https://inventory.yxy.com.sg).
# When set, Shopify webhooks are registered so website sales appear instantly.
# When empty, the dashboard re-syncs with Shopify every REFRESH_INTERVAL_SECONDS (default 30).
PUBLIC_URL=
REFRESH_INTERVAL_SECONDS=
